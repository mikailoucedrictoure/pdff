  "privacy.sections[0].text": "དེ་དག་གསང་བའི་སྒོ་ནས་ (HTTPS) བཏང་སྟེ་རང་འགུལ་གྱིས་ལས་སྣོན་བྱེད་ཅིང་། གྲུབ་འབྲས་འབྱོར་མ་ཐག་སུབ་རྒྱུ་ཡིན། ཡིག་ཆ་ཆེན་པོ་ཚོ་མིང་གང་རུང་ཞིག་གི་འོག་ནས་གནས་སྐབས་ཉར་ཚགས་ཁང་དུ་བསྐྱོད་དེ་ལས་སྣོན་གྲུབ་མ་ཐག་འཕྲལ་དུ་སུབ་རྒྱུ་ཡིན།",
  "privacy.sections[1].title": "རྩིས་ཐོ་མེད། སྒེར་གྱི་གནས་ཚུལ་མེད།",
  "privacy.sections[1].text": "pdff ལ་ཐོ་འགོད་དང་། གློག་འཕྲིན་ཁ་བྱང་། དངུལ་ཁང་བྱང་བུ་གང་ཡང་མི་དགོས། ཁྱེད་ཀྱི་ཡིག་ཆ་ནམ་ཡང་ཀློག་པའམ་དབྱེ་ཞིབ། མཉམ་སྤྱོད། རིག་ནུས་སྦྱོང་བརྡར་ལ་མི་སྤྱོད།",
  "privacy.sections[2].title": "ལྟད་མོ་བའི་གྲངས་འབོར།",
  "privacy.sections[2].text": "ང་ཚོས་མིང་མེད་པར་དང་ཀུ་ཀི་མེད་པར་ (Vercel Web Analytics) འཚམས་འདྲི་བརྩི་ཡི་ཡོད། ཚོང་བསྒྲགས་མེད་ལ་དྲ་ཚིགས་བརྒལ་ནས་རྗེས་འདེད་མི་གཏོང་།",
  "privacy.sections[3].title": "ཀུ་ཀི (Cookies)",
  "privacy.sections[3].text": "ཀུ་ཀི་གཅིག་རང་ཡོད་ཅིང་། དེས་ཁྱེད་ཀྱིས་འདེམས་པའི་སྐད་ཡིག་དྲན་གསོ་བྱེད་ཀྱི་ཡོད།",
  "privacy.sections[4].title": "ཞབས་ཞུ།",
  "privacy.sections[4].text": "དྲ་ཚིགས་འདི་ Vercel གྱིས་ 巴黎 སེར་ཝེར་ཐོག་གཉེར་བཞིན་ཡོད། Word, Excel དང་ PowerPoint བསྒྱུར་བ་ཚོ་ Frankfurt ཡོད་པའི་ Render གྱིས་ལྟ་རྟོག་བྱེད་ཀྱི་ཡོད།",
  "privacy.sections[5].title": "འབྲེལ་གཏུག",
