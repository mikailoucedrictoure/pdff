# ---- pdff : limites (modifiables à tout moment, aucun changement de code requis) ----
# Nombre maximum de pages dans un PDF produit (fusion, conversion…)
PDFF_MAX_PAGES=10000
# Nombre maximum de fichiers par opération
PDFF_MAX_FILES=500
# Taille maximale d'un envoi (Mo)
PDFF_MAX_UPLOAD_MB=2048

# Chemin vers LibreOffice (soffice) pour Word / Excel / PowerPoint.
# Laisser vide : détection automatique (PATH + emplacements Windows/macOS/Linux standards)
LIBREOFFICE_PATH=

# ---- Traduction automatique (toutes les langues hors fr, en, es, pt, ar, de, zh) ----
# Clé Vercel AI Gateway : https://vercel.com/dashboard → AI Gateway → API Keys
# Sur Vercel, l'authentification OIDC est automatique : cette clé n'est utile qu'en local.
AI_GATEWAY_API_KEY=
# Modèle utilisé pour traduire (format "fournisseur/modèle" de l'AI Gateway)
PDFF_TRANSLATION_MODEL=anthropic/claude-haiku-4.5
# Dossier du cache des traductions générées (par défaut : .cache/i18n)
PDFF_CACHE_DIR=
